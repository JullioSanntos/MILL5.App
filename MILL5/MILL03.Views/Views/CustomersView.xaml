<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MILL03.Views.Views.CustomersView"
             VerticalOptions="Fill" HorizontalOptions="Fill">

    <Grid RowDefinitions="Auto, Auto, *" VerticalOptions="Fill" HorizontalOptions="Fill">
        <!-- Row 0: Button using Command Binding -->
        <Button Grid.Row="0" Text="Load Customers" 
                Command="{Binding LoadCustomersCommand}" 
                Margin="10" TextColor="White" BackgroundColor="#2B579A">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#3E6DB3" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#1C3F75" />
                                <Setter Property="Scale" Value="0.98" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Button>

        <!-- Row 1: Decoupled Static Headers -->
        <Grid Grid.Row="1" ColumnDefinitions="100, 200, *" Margin="10,0,10,5">
            <Label Text="ID" FontAttributes="Bold" TextColor="Black" />
            <Label Text="Store ID" Grid.Column="1" FontAttributes="Bold" TextColor="Black" />
            <Label Text="Modified Date" Grid.Column="2" FontAttributes="Bold" TextColor="Black" />
        </Grid>

        <!-- Row 2: CollectionView bound directly to the ViewModel's property -->
        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding Customers}"
                        Margin="10,0,10,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="100, 200, *">
                        <Label Text="{Binding CustomerId}" TextColor="Black" />
                        <Label Text="{Binding StoreId}" Grid.Column="1" TextColor="Black" />
                        <Label Text="{Binding ModifiedDate, StringFormat='{0:d}'}" Grid.Column="2" TextColor="Black" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>