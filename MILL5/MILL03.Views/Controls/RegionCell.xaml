<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MILL03.Views.Controls"
             x:Class="MILL03.Views.Controls.RegionCell"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">

    <Grid x:Name="RootGrid"
          VerticalOptions="Fill"
          HorizontalOptions="Fill">

        <controls:Perimeter x:Name="SplitPerimeter">
            <controls:Perimeter.InnerContent>

                <Grid>
                    <ContentView x:Name="PayloadContainer"
                                 VerticalOptions="Fill"
                                 HorizontalOptions="Fill" />

                    <Label x:Name="CloseBtnLabel"
                           Style="{StaticResource RegionCloseButtonStyle}"
                           ZIndex="100">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseButtonTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

            </controls:Perimeter.InnerContent>
        </controls:Perimeter>

    </Grid>
</ContentView>