<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MILL03.Views.Controls.RegionCell">
    <Grid>
        <!-- Child 0: The payload landing zone -->
        <ContentView />

        <!-- Children 1-4: The Adorners -->
        <BoxView HeightRequest="5" VerticalOptions="Start" BackgroundColor="Transparent" />
        <BoxView HeightRequest="5" VerticalOptions="End" BackgroundColor="Transparent" />
        <BoxView WidthRequest="5" HorizontalOptions="Start" BackgroundColor="Transparent" />
        <BoxView WidthRequest="5" HorizontalOptions="End" BackgroundColor="Transparent" />

        <!-- Child 5: The Indicator -->
        <Label Text="+" FontSize="small" TextColor="White" FontAttributes="Bold"
               HorizontalOptions="Start" VerticalOptions="Start"
               IsVisible="False" InputTransparent="True" ZIndex="99" />
    </Grid>
</ContentView>