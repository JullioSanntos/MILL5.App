<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MILL03.Views.Controls.DropTarget">

    <Grid>

        <Border x:Name="Surface" Style="{DynamicResource DropTargetSurfaceStyle}"
                Stroke="Transparent" StrokeThickness="0">

            <ContentView x:Name="InnerContentHost"
                         VerticalOptions="Fill" HorizontalOptions="Fill" />

        </Border>

        <Border x:Name="AvailableCue"
                Style="{DynamicResource DropTargetAvailableStyle}"
                IsVisible="False"
                InputTransparent="True" />

        <Border x:Name="DragOverCue"
                Style="{DynamicResource DropTargetDragOverStyle}"
                IsVisible="False"
                InputTransparent="True">

            <Label Text="DROP HERE"
                   Style="{DynamicResource DropTargetLabelStyle}" />

        </Border>

    </Grid>

</ContentView>