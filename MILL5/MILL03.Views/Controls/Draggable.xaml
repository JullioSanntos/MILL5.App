<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MILL03.Views.Controls.Draggable">

    <Border x:Name="Surface" Style="{DynamicResource DraggableSurfaceStyle}">
        <Grid>

            <ContentView x:Name="InnerContentHost"
                         VerticalOptions="Fill"
                         HorizontalOptions="Fill" />

            <Label x:Name="DragIndicator"
                   Style="{DynamicResource DragIndicatorStyle}" />

        </Grid>
    </Border>

</ContentView>