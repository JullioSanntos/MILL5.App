<?xml version="1.0" encoding="utf-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MILL03.Views.Controls.Draggable">

    <Border x:Name="Surface" Style="{DynamicResource DraggableSurfaceStyle}">
        <Grid ColumnDefinitions="Auto,*">

            <Label x:Name="DragIndicator" Grid.Column="0" Text="⠿"
                   Style="{DynamicResource DragIndicatorStyle}" InputTransparent="True" />

            <ContentView x:Name="InnerContentHost" Grid.Column="1"
                         VerticalOptions="Fill" HorizontalOptions="Fill" />
        </Grid>
    </Border>

</ContentView>